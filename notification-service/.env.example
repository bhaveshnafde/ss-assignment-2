# Notification service configuration.
# Copy this file to .env (same folder) and set DB_PASSWORD. Never commit .env.
# The service reads .env when run from IntelliJ or mvn; docker-compose.dev.yml reads it too.
# DB_PASSWORD is the only required value; every other line has a default in application.yml.
# An existing local database keeps the password it was first created with: use that one here,
# or reset it with: docker compose -f docker-compose.dev.yml down -v
# No comments after a value on the same line: they would become part of the value.

PORT=8085

# This service's own database (separate DB and credentials from every other service)
DB_URL=jdbc:postgresql://localhost:5437/notification_db
DB_USERNAME=notification_user
DB_PASSWORD=change-me
DB_POOL_SIZE=20

# The simulated SMS/email provider (it can be slow or fail on purpose)
# Wait this long per send; above 3000 the Transfer service times out and retries
NOTIFY_DELAY_MS=0
# 0.0 to 1.0: share of sends that fail at random
NOTIFY_FAIL_RATE=0.0
# The next N sends fail, then sending works again (repeatable demos)
NOTIFY_FAIL_NEXT=0

# Switches for the provider at runtime: PUT /api/v1/admin/provider (set false outside demos)
ADMIN_ENDPOINTS_ENABLED=true

# Logging: logstash (JSON, default) or ecs
LOG_FORMAT=logstash
LOG_LEVEL=INFO
