# Transfer service configuration.
# Copy this file to .env (same folder) and set DB_PASSWORD. Never commit .env.
# The service reads .env when run from IntelliJ or mvn; docker-compose.dev.yml reads it too.
# DB_PASSWORD is the only required value; every other line has a default in application.yml.
# An existing local database keeps the password it was first created with: use that one here,
# or reset it with: docker compose -f docker-compose.dev.yml down -v
# No comments after a value on the same line: they would become part of the value.

PORT=8082

# This service's own database (separate DB and credentials from every other service)
DB_URL=jdbc:postgresql://localhost:5433/transfer_db
DB_USERNAME=transfer_user
DB_PASSWORD=change-me
DB_POOL_SIZE=20

# BR1: per-transfer cap
TRANSFER_MAX_AMOUNT=100000.00

# Other services
ACCOUNT_SERVICE_URL=http://localhost:8081
LEDGER_SERVICE_URL=http://localhost:8083
LIMITS_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
DOWNSTREAM_CONNECT_TIMEOUT_MS=1000
DOWNSTREAM_READ_TIMEOUT_MS=3000

# Retry with exponential backoff and jitter (only for "no answer": timeouts, connection errors, 5xx)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=2000

# Recovery job: finishes transfers stuck in a non-terminal state
RECOVERY_ENABLED=true
RECOVERY_INTERVAL_MS=15000
RECOVERY_STUCK_AFTER_SECONDS=60

# Logging: logstash (JSON, default) or ecs
LOG_FORMAT=logstash
LOG_LEVEL=INFO
